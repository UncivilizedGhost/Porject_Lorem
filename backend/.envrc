# Python venv setup — creates and activates .venv, installs deps via pip
# Usage: `direnv allow .envrc` then `source .venv/bin/activate`

# Create venv if it doesn't exist
if [ ! -d ".venv" ]; then
  python3 -m venv .venv
fi

# Activate venv and set PYTHONPATH
source "$PWD/.venv/bin/activate"
export PYTHONPATH="$PWD/src:${PYTHONPATH:-}"
