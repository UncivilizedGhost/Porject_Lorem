use flake

# Add venv site-packages for third-party deps not in nixpkgs (elevenlabs,
# python-dotenv). Nix provides python/ruff/pytest; the venv provides the rest.
if [ -d "$PWD/.venv" ]; then
  VENV_SITE=$(find "$PWD/.venv" -maxdepth 3 -type d -name site-packages | head -1)
  if [ -n "$VENV_SITE" ]; then
    export PYTHONPATH="$VENV_SITE:$PWD/src:${PYTHONPATH:-}"
  fi
fi
