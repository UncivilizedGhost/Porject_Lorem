# Secrets are kept out of Git.
#
# OpenCode reads the Verda inference key from a local file referenced in
# opencode.json as:  "apiKey": "{file:.secrets/verda_inference_key}"
#
# Create it once (the file must contain the key only, no trailing newline):
#
#   mkdir -p .secrets && chmod 700 .secrets
#   printf '%s' 'dc_...' > .secrets/verda_inference_key
#   chmod 600 .secrets/verda_inference_key
#
# .secrets/ is gitignored. Never commit the key, and never paste it into
# opencode.json, AGENTS.md, docs, or a shell history you share.
#
# If you would rather use an environment variable, switch the config back to
# "{env:VERDA_INFERENCE_KEY}" and export it before starting OpenCode.

# --- Pathway Companion server (server/) ---------------------------------------
# Local Postgres (server/compose.yaml) for the build; paste the Aiven service URI here to switch
# (it already ends in ?sslmode=require). Nothing else changes (ADR-0007).
DATABASE_URL=postgresql://pathway:pathway@localhost:5432/pathway
# Hosted deployments have no .secrets/ directory: these env vars are the fallback.
# VERDA_INFERENCE_KEY=
# ELEVENLABS_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Nemotron endpoint (Learn + dashboard summary). Key in .secrets/verda_inference_key.
NEMOTRON_BASE_URL=
NEMOTRON_MODEL=
NEMOTRON_TIMEOUT_S=8
# ElevenLabs key in .secrets/elevenlabs_key (ADR-0005). TTS cache:
VOICE_CACHE_DIR=server/.cache/voice
